{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "public/data/scenarios/**" }
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/data/(.*)",
      "dest": "/public/data/$1"
    },
    {
      "src": "/icon.svg",
      "dest": "/public/icon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}